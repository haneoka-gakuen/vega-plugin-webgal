{
  "name": "@haneoka/vega-plugin-webgal",
  "version": "0.1.0",
  "description": "WebGAL runtime compatibility profile and Pixi renderer for Vega",
  "keywords": [
    "visual-novel",
    "webgal",
    "pixijs",
    "compatibility",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-plugin-webgal.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-plugin-webgal#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-plugin-webgal/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE.webgal.md",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js",
      "default": "./dist/commands.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@haneoka/vega-renderer-pixi": "workspace:*",
    "@haneoka/vega-protocol": "^0.1.0",
    "popmotion": "^11.0.5",
    "pixi-filters": "^4.2.0"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0",
    "pixi.js": ">=6.3.0 <7"
  },
  "devDependencies": {
    "@haneoka/vega": "workspace:*",
    "pixi.js": "6.5.10",
    "typescript": "^6.0.3",
    "prettier": "3.7.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "vega": {
    "pluginApi": 1,
    "kind": "compatibility",
    "capabilities": [
      "render",
      "commands",
      "theme",
      "effect",
      "ui-slot"
    ],
    "permissions": [
      "render:webgl",
      "ui:dom"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
